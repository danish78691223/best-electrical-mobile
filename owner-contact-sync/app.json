{
  "expo": {
    "name": "BEST ELECTRICAL Owner Sync",
    "slug": "best-electrical-owner-sync",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow BEST ELECTRICAL Owner Sync to read phone contacts so the shop owner can import names and phone numbers."
        }
      ]
    ],
    "android": {
      "package": "com.bestelectrical.ownersync",
      "permissions": ["READ_CONTACTS"]
    }
  }
}
